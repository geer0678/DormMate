.chart-wrap { position: relative; }
.legend { display:flex; justify-content:space-between; font-size:21rpx; margin-bottom:12rpx; }
.temperature { color:#2563eb; }.humidity { color:#0f8b80; }
.chart { width:100%; height:420rpx; }
