page { background:#f3f6fb; color:#17253b; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
.shell { max-width:960rpx; margin:0 auto; padding:30rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.hero { padding:20rpx 4rpx 28rpx; }
.brand { font-size:58rpx; font-weight:800; color:#205bc5; line-height:1.2; }
.subtitle { font-size:25rpx; color:#64738a; margin-top:12rpx; line-height:1.6; }
.tabs { display:flex; position:sticky; top:0; z-index:3; padding:10rpx; background:#e9eff9; border-radius:18rpx; margin-bottom:28rpx; }
.tab { flex:1; margin:0; font-size:28rpx; color:#64738a; background:transparent; line-height:2.5; padding:0; border-radius:12rpx; }
button::after { border:0; }
.tab.selected { background:white; color:#215ac6; font-weight:700; }
.card { background:white; border-radius:24rpx; padding:30rpx; margin-bottom:24rpx; }
.card-title { font-size:32rpx; font-weight:700; margin-bottom:22rpx; }
.card.compact { padding:24rpx; }
.section-title { font-size:35rpx; font-weight:700; margin:12rpx 0 24rpx; }
.section-heading { display:flex; justify-content:space-between; align-items:center; }
.count { color:#637086; font-size:26rpx; }
.field-row,.metrics { display:flex; margin-bottom:22rpx; }
.field,.metric { flex:1; min-width:0; }
.field + .field,.metric + .metric { margin-left:20rpx; }
.field-label,.label { font-size:25rpx; color:#596b83; }
.field-label { display:block; margin-bottom:12rpx; }
input { box-sizing:border-box; width:100%; background:#f6f8fc; border:2rpx solid #dbe4f1; border-radius:14rpx; height:92rpx; padding:0 18rpx; font-size:31rpx; }
button { font-size:27rpx; line-height:2.8; background:#eaf0fb; color:#2858a5; font-weight:600; border-radius:14rpx; margin-top:16rpx; padding:0 18rpx; }
button.primary { background:#2d64ce; color:#fff; }
button[disabled] { background:#eef1f6!important; color:#9aa5b4!important; }
.hint { color:#6b7b91; font-size:23rpx; line-height:1.65; text-align:center; margin-top:16rpx; }
.hint.left { text-align:left; }
.time { color:#74849a; font-size:23rpx; margin-top:-10rpx; margin-bottom:24rpx; }
.metrics { margin-top:20rpx; }
.metric { background:#f2f6fc; padding:22rpx; border-radius:18rpx; }
.metric-value { font-size:50rpx; font-weight:750; margin-top:8rpx; }
.metric-value text { font-size:26rpx; font-weight:500; margin-left:6rpx; }
.status-row,.history-top { display:flex; justify-content:space-between; align-items:center; }
.status-row { padding-top:20rpx; border-top:2rpx solid #edf1f6; }
.status { display:inline-block; padding:7rpx 16rpx; border-radius:10rpx; font-size:24rpx; font-weight:600; white-space:nowrap; }
.normal { color:#157849; background:#e1f4e9; }.attention { color:#a5520b; background:#fff0dc; }.waiting { color:#66768c; background:#edf1f6; }
.advice { font-size:29rpx; line-height:1.7; margin-top:20rpx; }
.switch-row { display:flex; justify-content:space-between; align-items:center; font-size:25rpx; color:#596b83; margin:22rpx 0; }
.switch-row switch { transform:scale(.85); transform-origin:right center; }
.actions { display:flex; flex-wrap:wrap; }
.actions button { flex:1; min-width:0; padding:0 10rpx; }
.actions button + button { margin-left:14rpx; }
.text-button { background:transparent; color:#2858a5; font-size:25rpx; padding:0; }
.danger { color:#b53d35; }
.message { background:#e6eefc; color:#295893; padding:20rpx 24rpx; font-size:25rpx; line-height:1.6; border-radius:14rpx; margin-bottom:20rpx; word-break:break-all; }
.error { background:#fff0ee; color:#b73d35; }
.summary-line { font-size:24rpx; line-height:1.6; color:#66768c; text-align:center; padding:12rpx; }
.empty { padding:54rpx 26rpx; font-size:27rpx; color:#728198; text-align:center; line-height:1.7; }
.history-card { background:#fff; border-radius:18rpx; padding:24rpx; margin-bottom:16rpx; }
.history-top { font-size:22rpx; color:#74849a; }
.history-values { font-size:33rpx; font-weight:700; margin:20rpx 0 12rpx; }
.history-values text { font-size:23rpx; font-weight:400; color:#708096; margin-left:8rpx; }
.history-values .separator { padding:0 20rpx; color:#c2cbd9; }
.history-advice { font-size:25rpx; line-height:1.65; color:#53647c; }
.stats { display:flex; flex-wrap:wrap; justify-content:space-between; }
.stat { box-sizing:border-box; width:48.5%; background:#fff; padding:26rpx; border-radius:18rpx; margin-bottom:18rpx; }
.stat-value { font-size:38rpx; font-weight:750; color:#225cc6; margin-bottom:10rpx; word-break:break-all; }
.stat-value text { font-size:23rpx; margin-left:6rpx; font-weight:400; }
.stat-range { color:#7a889c; font-size:23rpx; margin-top:10rpx; }
.source-note { font-size:24rpx; color:#66768c; margin:-8rpx 0 24rpx; }
.chart-card { margin-top:8rpx; }
.distribution-row { display:flex; align-items:center; margin:22rpx 0; }
.distribution-label { width:128rpx; font-size:24rpx; }
.bar-track { flex:1; height:16rpx; background:#f0f3f8; border-radius:4rpx; overflow:hidden; }
.bar { height:100%; background:#edaf64; border-radius:4rpx; }.green-bar { background:#50b88b; }
.distribution-value { width:65rpx; text-align:right; color:#68788d; font-size:23rpx; }
.camera { width:100%; height:440rpx; }
.camera-placeholder { height:330rpx; display:flex; flex-direction:column; justify-content:center; align-items:center; background:#eff4fb; color:#74849a; font-size:24rpx; text-align:center; padding:0 18rpx; }
.camera-symbol { font-size:84rpx; color:#849ec6; margin-bottom:16rpx; }
.photo { width:100%; border-radius:12rpx; margin-top:22rpx; }
textarea { width:100%; box-sizing:border-box; padding:20rpx; background:#f5f8fc; border:2rpx solid #e0e7f1; border-radius:14rpx; font-size:28rpx; line-height:1.6; }
.tts-input { height:220rpx; }
.paste-box,.export-box { padding-top:20rpx; margin-top:20rpx; border-top:2rpx solid #e6edf5; }
.paste-box textarea { min-height:160rpx; max-height:420rpx; }
.filename { word-break:break-all; font-size:26rpx; color:#365477; }
.speech-result { margin-top:24rpx; padding:22rpx; background:#f4f7fc; border-radius:14rpx; font-size:28rpx; line-height:1.7; }
.speech-result .label { margin-bottom:10rpx; }
.service-note { color:#986224; background:#fff5e6; padding:18rpx; border-radius:12rpx; font-size:25rpx; line-height:1.6; }
.command-list { font-size:27rpx; line-height:1.8; color:#51637c; }
.command-input { margin-top:20rpx; font-size:26rpx; }

